{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist",
    "noEmit": true
  },
  "ts-node": {
    "transpileOnly": false
  },
  "include": [
    "config/**/*.ts",
    "hooks/**/*.ts",
    "pages/**/*.ts",
    "step-definitions/**/*.ts",
    "test-runner/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "reports", "screenshots"]
}
